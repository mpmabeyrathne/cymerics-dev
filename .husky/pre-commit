#!/usr/bin/env sh

BRANCH=$(git branch --show-current)

if ! echo "$BRANCH" | grep -Eq '^(feature|fix|chore|refactor|docs|test)/[A-Z0-9]+-[0-9]+(-[a-z0-9-]+)*$'; then
  echo "❌ Invalid branch name: $BRANCH"
  echo ""
  echo "Branch name must follow:"
  echo "<type>/<TICKET-ID>-<description>"
  echo ""
  echo "Example:"
  echo "feature/CYM-123-initialize-backend"
  exit 1
fi
